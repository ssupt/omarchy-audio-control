#!/bin/bash
# Build and install the backend atomically.
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source "$ROOT/scripts/.audio-common"
MANIFEST="$ROOT/backend/Cargo.toml"
SERVICE=omarchy-audio-control.service
SOCKET=omarchy-audio-control.socket
# SHA-256 digests of the pre-unit-state shipped units for legacy upgrades/uninstalls.
LEGACY_SERVICE_SHA256=84c07ff286984d34cbae69ffa1d0b0c6abb57d84b580168c1ade5eb8df13503b
LEGACY_SOCKET_SHA256=5f5b4182389291cbab49ecc5e3eb4a1d440af4c465f1780f27eff1ba8de0d4cc
ACTION=${1:-}
[[ $# -gt 0 ]] && shift
STAGE=""
BINARY=""
while (( $# )); do
  case $1 in
    --stage) [[ $# -ge 2 && -z $STAGE ]] || exit 2; STAGE=$2; shift 2 ;;
    --binary) [[ $# -ge 2 && -z $BINARY ]] || exit 2; BINARY=$2; shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
done
valid_base_path() {
  local p=$1
  [[ $p == /* && $p != / && $p != */.. && $p != */../* && $p != */. && $p != */./* ]]
}
if [[ -n $STAGE ]]; then
  while [[ $STAGE == */ && $STAGE != / ]]; do STAGE=${STAGE%/}; done
  valid_base_path "$STAGE" || exit 2
  INSTALL_BASE=$STAGE
  CONFIG_BASE="$STAGE/.config"
else
  INSTALL_BASE=${HOME:?}
  CONFIG_BASE=${XDG_CONFIG_HOME:-"$HOME/.config"}
fi
while [[ $INSTALL_BASE == */ && $INSTALL_BASE != / ]]; do INSTALL_BASE=${INSTALL_BASE%/}; done
while [[ $CONFIG_BASE == */ && $CONFIG_BASE != / ]]; do CONFIG_BASE=${CONFIG_BASE%/}; done
valid_base_path "$INSTALL_BASE" && valid_base_path "$CONFIG_BASE" || exit 2
LIBEXEC_DIR="$INSTALL_BASE/.local/libexec/omarchy-audio-control"
UNIT_STATE_DIR="$LIBEXEC_DIR/unit-state"
UNIT_DIR="$CONFIG_BASE/systemd/user"

ensure_dir() {
  local dir=$1 mode=$2
  while [[ $dir == */ && $dir != / ]]; do dir=${dir%/}; done
  [[ -n $dir ]] || dir=/
  if [[ -d $dir ]]; then
    return 0
  fi
  if [[ -e $dir || -L $dir ]]; then
    echo "Refusing to use non-directory path: $dir" >&2
    return 1
  fi
  ensure_dir "${dir%/*}" "$mode"
  mkdir -m "$mode" -- "$dir"
}

acquire_install_lock() {
  local sum
  audio_prepare_private_runtime || return 1
  sum=$(printf '%s' "$LIBEXEC_DIR" | sha256sum) || return 1
  audio_open_lock_path \
    "$AUDIO_CONTROL_PRIVATE_RUNTIME_DIR/audio-backend-install-${sum:0:24}.lock" 9 \
    "Another audio backend installation is already in progress"
}

file_sha256() {
  local out
  out=$(sha256sum < "$1") || return 1
  printf '%s\n' "${out%% *}"
}

is_known_shipped_unit() {
  local path=$1 unit=$2 sha
  cmp -s -- "$path" "$ROOT/packaging/systemd/$unit" && return 0
  sha=$(file_sha256 "$path") || return 1
  case $unit in
    "$SERVICE") [[ $sha == "$LEGACY_SERVICE_SHA256" ]] ;;
    "$SOCKET") [[ $sha == "$LEGACY_SOCKET_SHA256" ]] ;;
    *) return 1 ;;
  esac
}

build() {
  local artifacts
  artifacts=$(mktemp)
  if ! cargo build --locked --release --manifest-path "$MANIFEST" \
      --message-format=json-render-diagnostics >"$artifacts"; then
    rm -f -- "$artifacts"
    return 1
  fi
  BINARY=$(python3 - "$artifacts" <<'PY'
import json, sys
paths = [v['executable'] for line in open(sys.argv[1])
         if (v := json.loads(line)).get('reason') == 'compiler-artifact'
         and v.get('executable') and v.get('target', {}).get('name') == 'omarchy-audio-service']
if len(paths) != 1: raise SystemExit('Could not identify the built backend executable')
print(paths[0])
PY
  )
  rm -f -- "$artifacts"
}
manager() {
  if [[ -z $STAGE ]]; then
    systemctl --user "$@"
  elif [[ -n ${AUDIO_BACKEND_STAGE_SYSTEMCTL:-} ]]; then
    [[ $AUDIO_BACKEND_STAGE_SYSTEMCTL == /* ]] || return 2
    "$AUDIO_BACKEND_STAGE_SYSTEMCTL" "$@"
  fi
}

manager_active() {
  [[ -z $STAGE || -n ${AUDIO_BACKEND_STAGE_SYSTEMCTL:-} ]]
}

unit_confirmed_stopped() {
  local unit=$1 rc=0
  if ! manager_active; then
    return 0
  fi
  manager is-active --quiet "$unit" 2>/dev/null || rc=$?
  # systemctl is-active exits 3 (inactive/failed) or 4 (unknown/not-found).
  # Exit 0 means active; exit 1 (or other) means the manager could not be queried.
  (( rc == 3 || rc == 4 ))
}

stop_unit_for_uninstall() {
  local unit=$1 action=$2 rc=0 state=""
  if ! manager_active; then
    return 0
  fi
  if [[ $action == disable ]]; then
    if manager disable --now "$unit" 2>/dev/null; then return 0; fi
  else
    if manager stop "$unit" 2>/dev/null; then return 0; fi
  fi
  state=$(manager is-active "$unit" 2>/dev/null) || rc=$?
  if (( rc == 3 || rc == 4 )); then
    return 0
  fi
  # Allow a missing-unit stub manager that succeeded on preflight daemon-reload
  # and emitted no active state; real systemctl always prints a state on exit 0.
  if [[ ! -e $UNIT_DIR/$unit ]] && (( rc == 0 )) && [[ -z $state ]]; then
    return 0
  fi
  echo "Cannot confirm $unit is stopped; preserving existing installation" >&2
  exit 1
}

# Installed files and the selected release form one upgrade transaction. Run on
# any failure after the first replacement, including filesystem errors/signals.
rollback_install() {
  local status=$1 restored=true unit
  trap - EXIT HUP INT TERM
  set +e
  if $daemon_touched && [[ -z $previous ]]; then
    if ! $socket_was_enabled; then
      if ! manager disable --now "$SOCKET" 2>/dev/null; then
        if ! unit_confirmed_stopped "$SOCKET"; then
          restored=false
        fi
      fi
    fi
    if [[ -f $release/previous-units/$SERVICE ]]; then
      manager stop "$SERVICE" || restored=false
    elif ! unit_confirmed_stopped "$SERVICE"; then
      manager stop "$SERVICE" || restored=false
    fi
  fi
  for unit in "$SERVICE" "$SOCKET"; do
    if [[ -f $release/previous-units/$unit ]]; then
      if cp -p -- "$release/previous-units/$unit" "$unit_stage/$unit"; then
        mv -Tf -- "$unit_stage/$unit" "$UNIT_DIR/$unit" || restored=false
      else
        restored=false
      fi
    else
      rm -f -- "$UNIT_DIR/$unit" || restored=false
    fi
    if [[ -f $release/previous-units/$unit.installed.sha256 ]]; then
      if cp -p -- "$release/previous-units/$unit.installed.sha256" "$state_stage/$unit.installed.sha256"; then
        mv -Tf -- "$state_stage/$unit.installed.sha256" "$UNIT_STATE_DIR/$unit.installed.sha256" || restored=false
      else
        restored=false
      fi
    else
      rm -f -- "$UNIT_STATE_DIR/$unit.installed.sha256" || restored=false
    fi
    if [[ -f $release/previous-units/$unit.created-original ]]; then
      rm -f -- "$UNIT_STATE_DIR/$unit.original" || restored=false
    fi
  done
  rm -rf -- "${link_dir:-}" || restored=false
  if [[ -n $previous ]]; then
    local restore_link_dir
    if restore_link_dir=$(mktemp -d "$LIBEXEC_DIR/.current.XXXXXXXX") &&
        ln -s -- "$previous" "$restore_link_dir/current"; then
      mv -Tf -- "$restore_link_dir/current" "$LIBEXEC_DIR/current" || restored=false
    else
      restored=false
    fi
    rm -rf -- "${restore_link_dir:-}"
  else
    rm -f -- "$LIBEXEC_DIR/current" || restored=false
  fi
  if $daemon_touched || [[ -n $previous ]]; then
    manager daemon-reload || restored=false
  fi
  if $was_active && { [[ -n $previous ]] || [[ -f $release/previous-units/$SERVICE ]]; }; then
    manager restart "$SERVICE" || restored=false
  fi
  rm -rf -- "${unit_stage:-}" "${state_stage:-}"
  rmdir -- "$UNIT_STATE_DIR" 2>/dev/null || true
  if $restored; then
    rm -rf -- "$release"
    rmdir -- "$LIBEXEC_DIR/releases" "$LIBEXEC_DIR" 2>/dev/null || true
    echo "Backend installation failed; the previous installation was restored" >&2
  else
    echo "Backend installation failed; rollback was incomplete (backup: $release/previous-units)" >&2
  fi
  exit "$status"
}

case $ACTION in
  build)
    [[ -z $BINARY && -z $STAGE ]] || exit 2
    build
    echo "$BINARY"
    ;;
  install)
    acquire_install_lock
    if [[ -z $BINARY ]]; then build; fi
    [[ $BINARY == /* && -f $BINARY && -x $BINARY ]] || {
      echo "--binary requires an absolute executable path" >&2; exit 2;
    }
    [[ ! -L $LIBEXEC_DIR ]] || {
      echo "Refusing to use symlinked libexec directory" >&2; exit 1;
    }
    [[ ! -L $LIBEXEC_DIR/releases ]] || {
      echo "Refusing to use symlinked releases directory" >&2; exit 1;
    }
    [[ ! -L $UNIT_STATE_DIR ]] || {
      echo "Refusing to use symlinked unit state directory" >&2; exit 1;
    }
    [[ ! -e $LIBEXEC_DIR/current || -L $LIBEXEC_DIR/current ]] || {
      echo "Refusing to replace an unmanaged current release" >&2; exit 1;
    }
    for unit in "$SERVICE" "$SOCKET"; do
      if [[ -e $UNIT_DIR/$unit || -L $UNIT_DIR/$unit ]]; then
        [[ -f $UNIT_DIR/$unit && ! -L $UNIT_DIR/$unit ]] || {
          echo "Refusing to replace a non-regular user unit" >&2; exit 1;
        }
      fi
      for suffix in installed.sha256 original; do
        if [[ -e $UNIT_STATE_DIR/$unit.$suffix || -L $UNIT_STATE_DIR/$unit.$suffix ]]; then
          [[ -f $UNIT_STATE_DIR/$unit.$suffix && ! -L $UNIT_STATE_DIR/$unit.$suffix ]] || {
            echo "Refusing to use non-regular unit state file" >&2; exit 1;
          }
        fi
      done
    done
    ensure_dir "$LIBEXEC_DIR/releases" 755
    ensure_dir "$UNIT_DIR" 755
    ensure_dir "$CONFIG_BASE/omarchy" 755
    unit_stage=""
    state_stage=""
    link_dir=""
    release=$(mktemp -d "$LIBEXEC_DIR/releases/release.XXXXXXXX")
    trap 'rm -rf -- "${unit_stage:-}" "${state_stage:-}" "${link_dir:-}" "$release"; rmdir -- "$UNIT_STATE_DIR" "$LIBEXEC_DIR/releases" "$LIBEXEC_DIR" 2>/dev/null || true' EXIT
    ensure_dir "$UNIT_STATE_DIR" 700
    [[ -d $UNIT_STATE_DIR && ! -L $UNIT_STATE_DIR ]] || {
      echo "Refusing to use symlinked unit state directory" >&2; exit 1;
    }
    chmod 755 -- "$release"
    install -m 755 -- "$BINARY" "$release/omarchy-audio-service"
    touch "$release/.audio-control-release"
    previous=$(readlink -- "$LIBEXEC_DIR/current" || true)
    was_active=false
    socket_was_enabled=false
    daemon_touched=false
    if { [[ -z $STAGE ]] || [[ -n ${AUDIO_BACKEND_STAGE_SYSTEMCTL:-} ]]; }; then
      if manager is-active --quiet "$SERVICE"; then was_active=true; fi
      if [[ -f $UNIT_DIR/$SOCKET ]] && manager is-enabled --quiet "$SOCKET" 2>/dev/null; then
        socket_was_enabled=true
      fi
    fi
    mkdir -m 700 -- "$release/previous-units"
    unit_stage=$(mktemp -d "$UNIT_DIR/.audio-backend.XXXXXXXX")
    state_stage=$(mktemp -d "$UNIT_STATE_DIR/.stage.XXXXXXXX")
    for unit in "$SERVICE" "$SOCKET"; do
      replace=true
      if [[ -e $UNIT_DIR/$unit ]]; then
        cp -p -- "$UNIT_DIR/$unit" "$release/previous-units/$unit"
      fi
      if [[ -f $UNIT_STATE_DIR/$unit.installed.sha256 ]]; then
        cp -p -- "$UNIT_STATE_DIR/$unit.installed.sha256" "$release/previous-units/$unit.installed.sha256"
        if [[ -f $release/previous-units/$unit ]]; then
          expected_sha=$(<"$UNIT_STATE_DIR/$unit.installed.sha256")
          current_sha=$(file_sha256 "$release/previous-units/$unit")
          if [[ $current_sha != "$expected_sha" ]]; then
            # Preserve user customizations made after the previous installation.
            replace=false
          fi
        fi
      elif [[ -f $release/previous-units/$unit ]]; then
        if [[ -z $previous ]]; then
          if [[ ! -e $UNIT_STATE_DIR/$unit.original ]]; then
            cp -p -- "$release/previous-units/$unit" "$state_stage/$unit.original"
            touch "$release/previous-units/$unit.created-original"
          fi
        elif ! is_known_shipped_unit "$release/previous-units/$unit" "$unit"; then
          # Preserve user edits made on top of a legacy pre-unit-state install.
          replace=false
        fi
      fi
      if $replace; then
        install -m 644 -- "$ROOT/packaging/systemd/$unit" "$unit_stage/$unit"
        file_sha256 "$unit_stage/$unit" >"$state_stage/$unit.installed.sha256"
        chmod 600 -- "$state_stage/$unit.installed.sha256"
      fi
    done
    link_dir=$(mktemp -d "$LIBEXEC_DIR/.current.XXXXXXXX")
    link="$link_dir/current"
    ln -s -- "releases/${release##*/}" "$link"
    trap 'rollback_install "$?"' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    for unit in "$SERVICE" "$SOCKET"; do
      if [[ -f $state_stage/$unit.original ]]; then
        mv -Tf -- "$state_stage/$unit.original" "$UNIT_STATE_DIR/$unit.original"
      fi
      if [[ -f $unit_stage/$unit ]]; then
        mv -Tf -- "$unit_stage/$unit" "$UNIT_DIR/$unit"
      fi
      if [[ -f $state_stage/$unit.installed.sha256 ]]; then
        mv -Tf -- "$state_stage/$unit.installed.sha256" "$UNIT_STATE_DIR/$unit.installed.sha256"
      fi
    done
    mv -Tf -- "$link" "$LIBEXEC_DIR/current"
    rm -rf -- "$link_dir"
    link_dir=""
    activated=false
    daemon_touched=true
    if manager daemon-reload && manager enable --now "$SOCKET"; then
      if ! $was_active || manager restart "$SERVICE"; then activated=true; fi
    fi
    if ! $activated; then
      exit 1
    fi
    trap - EXIT HUP INT TERM
    rm -rf -- "$unit_stage" "$state_stage"
    echo "Installed $LIBEXEC_DIR/current"
    ;;
  uninstall)
    acquire_install_lock
    [[ ! -L $LIBEXEC_DIR ]] || {
      echo "Refusing to use symlinked libexec directory" >&2; exit 1;
    }
    [[ ! -L $LIBEXEC_DIR/releases ]] || {
      echo "Refusing to use symlinked releases directory" >&2; exit 1;
    }
    [[ ! -L $UNIT_STATE_DIR ]] || {
      echo "Refusing to use symlinked unit state directory" >&2; exit 1;
    }
    had_current=false
    changed=false
    if [[ -L $LIBEXEC_DIR/current ]]; then had_current=true; changed=true; fi
    if [[ -d $UNIT_STATE_DIR ]]; then changed=true; fi
    for release in "$LIBEXEC_DIR"/releases/release.*; do
      [[ -d $release && ! -L $release && -f $release/.audio-control-release ]] || continue
      changed=true
      break
    done
    if { $changed || [[ -f $UNIT_STATE_DIR/$SOCKET.installed.sha256 ]] || [[ -f $UNIT_STATE_DIR/$SERVICE.installed.sha256 ]]; } && manager_active; then
      manager daemon-reload || {
        echo "Cannot reach systemd user manager; preserving existing installation" >&2
        exit 1
      }
    fi
    if [[ -f $UNIT_STATE_DIR/$SOCKET.installed.sha256 ]] || $had_current; then
      stop_unit_for_uninstall "$SOCKET" disable
    fi
    if [[ -f $UNIT_STATE_DIR/$SERVICE.installed.sha256 ]] || $had_current; then
      stop_unit_for_uninstall "$SERVICE" stop
    fi
    restore_tmp=""
    trap '[[ -n $restore_tmp ]] && rm -f -- "$restore_tmp"' EXIT
    for unit in "$SERVICE" "$SOCKET"; do
      if [[ -f $UNIT_STATE_DIR/$unit.installed.sha256 && ! -L $UNIT_STATE_DIR/$unit.installed.sha256 ]]; then
        expected_sha=$(<"$UNIT_STATE_DIR/$unit.installed.sha256")
        if [[ -f $UNIT_DIR/$unit && ! -L $UNIT_DIR/$unit ]]; then
          current_sha=$(file_sha256 "$UNIT_DIR/$unit")
          if [[ $current_sha == "$expected_sha" ]]; then
            changed=true
            if [[ -f $UNIT_STATE_DIR/$unit.original && ! -L $UNIT_STATE_DIR/$unit.original ]]; then
              restore_tmp=$(mktemp "$UNIT_DIR/.audio-backend-restore.XXXXXXXX")
              cp -p -- "$UNIT_STATE_DIR/$unit.original" "$restore_tmp"
              mv -Tf -- "$restore_tmp" "$UNIT_DIR/$unit"
              restore_tmp=""
            else
              rm -f -- "$UNIT_DIR/$unit"
            fi
          fi
        fi
      elif $had_current && [[ ! -d $UNIT_STATE_DIR && -f $UNIT_DIR/$unit && ! -L $UNIT_DIR/$unit ]]; then
        if is_known_shipped_unit "$UNIT_DIR/$unit" "$unit"; then
          changed=true
          rm -f -- "$UNIT_DIR/$unit"
        fi
      fi
    done
    trap - EXIT
    if $had_current; then
      rm -f -- "$LIBEXEC_DIR/current"
    fi
    if [[ -d $UNIT_STATE_DIR && ! -L $UNIT_STATE_DIR ]]; then
      rm -rf -- "$UNIT_STATE_DIR"
    fi
    for release in "$LIBEXEC_DIR"/releases/release.*; do
      [[ -d $release && ! -L $release && -f $release/.audio-control-release ]] || continue
      changed=true
      rm -rf -- "$release"
    done
    rmdir -- "$LIBEXEC_DIR/releases" "$LIBEXEC_DIR" 2>/dev/null || true
    if $changed; then
      manager daemon-reload
    fi
    ;;
  status)
    [[ -z $STAGE && -z $BINARY ]] || exit 2
    manager status "$SOCKET" "$SERVICE"
    ;;
  *) echo "Usage: ${0##*/} build|install|uninstall|status [--stage ABSOLUTE_DIR] [--binary ABSOLUTE_FILE]" >&2; exit 2 ;;
esac
