#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
TEST_DIR="$ROOT/test"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

for script in "$ROOT"/scripts/*; do
  bash -n "$script" || fail "bash syntax: ${script##*/}"
done
echo "PASS: helper syntax"

node - "$ROOT/Model.js" <<'JS'
const assert = require('node:assert/strict')
const model = require(process.argv[2])

const cards = model.parseAudioProfiles(JSON.stringify([{
  name: 'bluez_card.test',
  label: 'Headphones',
  bluetooth: true,
  activeProfile: 'a2dp-aac',
  profiles: [
    { value: 'a2dp-aac', label: 'High Fidelity Playback (codec AAC)', sinks: 1, sources: 0 },
    { value: 'headset-msbc', label: 'Headset Head Unit (codec mSBC)', sinks: 1, sources: 1 }
  ]
}]))

assert.equal(cards.length, 1)
assert.equal(model.hasBluetoothCards(cards), true)
assert.deepEqual(model.audioCardsByBluetooth(cards, true).map(card => card.label), ['Headphones'])
assert.deepEqual(model.audioProfileOptions(cards[0]), [
  { value: 'a2dp-aac', label: 'High fidelity (AAC, no microphone)' },
  { value: 'headset-msbc', label: 'Headset (mSBC, microphone)' }
])

const defaultOutput = {
  name: 'default-output',
  nickname: 'Desk Speakers',
  ready: true,
  properties: { 'object.serial': 10 }
}
const headphones = {
  name: 'headphones',
  nickname: 'Headphones',
  ready: true,
  properties: { 'object.serial': 11 }
}
assert.deepEqual(model.streamOutputOptions([defaultOutput, headphones], defaultOutput), [
  { value: 'default:10', label: 'Follow default output' },
  { value: 'override:10', label: 'Always use Desk Speakers' },
  { value: 'override:11', label: 'Always use Headphones' }
])
console.log('PASS: profile and routing model')
JS

route_log=$(mktemp)
trap 'rm -f "$route_log"' EXIT

AUDIO_CONTROL_ROUTE_LOG="$route_log" PATH="$TEST_DIR/mocks:$PATH" \
  "$ROOT/scripts/audio-stream-route-set" 300 101 override

expected_route_log=$(cat <<'EOF'
move-sink-input 300 101
pw-metadata -n default -- 900 target.object 101 Spa:Id
pw-metadata -n default -- 900 target.node 1001 Spa:Id
EOF
)
[[ $(<"$route_log") == "$expected_route_log" ]] || fail "persistent stream target"

: >"$route_log"
AUDIO_CONTROL_ROUTE_LOG="$route_log" PATH="$TEST_DIR/mocks:$PATH" \
  "$ROOT/scripts/audio-stream-route-set" 300 101 default

expected_route_log=$(cat <<'EOF'
move-sink-input 300 101
pw-metadata -n default -- 900 target.object -1 Spa:Id
pw-metadata -n default -- 900 target.node -1 Spa:Id
EOF
)
[[ $(<"$route_log") == "$expected_route_log" ]] || fail "default-following stream target"
echo "PASS: persistent application routing"

profiles=$(
  AUDIO_CONTROL_CARD_FIXTURE="$TEST_DIR/fixtures/cards.json" \
    PATH="$TEST_DIR/mocks:$PATH" \
    "$ROOT/scripts/audio-profiles"
)

jq -e '
  def values($label): .[] | select(.label == $label) | [.profiles[].value];
  (values("USB Headset") == [
    "output:analog-stereo+input:mono-fallback",
    "output:analog-stereo",
    "input:mono-fallback",
    "off"
  ])
  and (values("Bluetooth Headphones") | index("a2dp-sink-aac") != null)
  and (values("Bluetooth Headphones") | index("headset-head-unit-msbc") != null)
  and (values("HDMI Receiver") | index("output:hdmi-surround") != null)
  and (values("UCM Analog Codec") == [
    "HiFi (Headphones, Mic1)",
    "HiFi (Mic1, Speaker)",
    "off"
  ])
' <<<"$profiles" >/dev/null || fail "safe profile filtering"
echo "PASS: safe profile filtering"

profile_log=$(mktemp)
profile_state=$(mktemp)
trap 'rm -f "$route_log" "$profile_log" "$profile_state"' EXIT
printf 'old\n' >"$profile_state"

if AUDIO_CONTROL_CARD_FIXTURE="$TEST_DIR/fixtures/cards.json" \
  AUDIO_CONTROL_PROFILE_LOG="$profile_log" \
  AUDIO_CONTROL_PROFILE_STATE="$profile_state" \
  PATH="$TEST_DIR/mocks:$PATH" \
  "$ROOT/scripts/audio-profile-set" \
    alsa_card.usb-example-headset output:iec958-ac3-surround-51 >/dev/null 2>&1; then
  fail "unsafe profile accepted"
fi
[[ ! -s $profile_log ]] || fail "unsafe profile changed hardware"

AUDIO_CONTROL_CARD_FIXTURE="$TEST_DIR/fixtures/cards.json" \
  AUDIO_CONTROL_PROFILE_LOG="$profile_log" \
  AUDIO_CONTROL_PROFILE_STATE="$profile_state" \
  PATH="$TEST_DIR/mocks:$PATH" \
  "$ROOT/scripts/audio-profile-set" \
    alsa_card.usb-example-headset output:analog-stereo+input:mono-fallback

expected_profile_log=$(cat <<'EOF'
set-sink-mute 100 true
set-sink-input-mute 300 true
set-card-profile alsa_card.usb-example-headset output:analog-stereo+input:mono-fallback
set-sink-mute 101 true
set-sink-volume 101 42%
set-sink-mute 101 false
set-source-volume 200 36%
set-source-mute 200 true
set-sink-input-mute 300 false
EOF
)
[[ $(<"$profile_log") == "$expected_profile_log" ]] || fail "safe profile transition order"
echo "PASS: safe profile transition"

menu_tmp=$(mktemp -d)
menu_file="$menu_tmp/omarchy-menu.jsonc"
trap 'rm -f "$route_log" "$profile_log" "$profile_state"; rm -rf "$menu_tmp"' EXIT
cat >"$menu_file" <<'EOF'
{
  // Existing customization
  "personal.notes": {"icon":"N","label":"Notes","action":"true"}
}
EOF

AUDIO_CONTROL_MENU_FILE="$menu_file" AUDIO_CONTROL_SKIP_MENU_REFRESH=1 \
  "$ROOT/scripts/audio-menu-entry" install
AUDIO_CONTROL_MENU_FILE="$menu_file" AUDIO_CONTROL_SKIP_MENU_REFRESH=1 \
  "$ROOT/scripts/audio-menu-entry" install

node - "$menu_file" <<'JS'
const assert = require('node:assert/strict')
const fs = require('node:fs')
const raw = fs.readFileSync(process.argv[2], 'utf8')
const parsed = JSON.parse(raw.replace(/^\s*\/\/[^\n]*(\n|$)/gm, '').replace(/,(\s*[}\]])/g, '$1'))
assert.equal(parsed['personal.notes'].label, 'Notes')
assert.equal(parsed['setup.audio'].label, 'Audio')
assert.equal((raw.match(/"setup\.audio"/g) || []).length, 1)
JS

AUDIO_CONTROL_MENU_FILE="$menu_file" AUDIO_CONTROL_SKIP_MENU_REFRESH=1 \
  "$ROOT/scripts/audio-menu-entry" remove
grep -q '"personal.notes"' "$menu_file" || fail "menu integration removed another entry"
! grep -q '"setup.audio"' "$menu_file" || fail "menu integration removal"
echo "PASS: menu integration"

jq -e '
  .schemaVersion == 1
  and .id == "ssupt.audio-control"
  and .version == "0.2.0"
  and .author == "ssupt"
  and (.kinds | index("bar-widget") != null)
  and (.kinds | index("panel") != null)
  and .omarchy.clonedFrom == "omarchy.audio"
' "$ROOT/manifest.json" >/dev/null || fail "manifest"
echo "PASS: manifest"
